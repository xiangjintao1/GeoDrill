    {"id":"loss-not-enough","observations":{"lost_returns":"yes"},"expected":{"natural-loss":"incomplete","induced-loss":"incomplete"}},
    {"id":"induced-loss-supported","observations":{"lost_returns":"yes","above_fracture_limit":"yes"},"expected":{"induced-loss":"compatible","natural-loss":"incomplete"}},
    {"id":"no-motion-limit","observations":{"stuck":"no","circulation_restricted":"yes","pump_pressure_rise":"yes"},"expected":{"packoff":"compatible","packoff-sticking":"conflicting","mechanical":"conflicting"}}
