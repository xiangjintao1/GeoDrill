namespace Drilling

DrillingMethod(钻进方法): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text
        usesBit(使用钻头): DrillBit
            constraint: MultiValue
        usesTool(使用钻具): DrillingTool
            constraint: MultiValue
        applicableTo(适用地层): Formation
            constraint: MultiValue
        usesCoringMethod(采用取心方法): CoringMethod
            constraint: MultiValue

CoringMethod(取心方法): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text
        usesTool(使用钻具): DrillingTool
            constraint: MultiValue
        applicableTo(适用地层): Formation
            constraint: MultiValue
        affectsQuality(影响取心质量): QualityIndicator
            constraint: MultiValue

DrillBit(钻头): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text
        applicableTo(适用地层): Formation
            constraint: MultiValue
        model(型号): Text
            index: Text

DrillingTool(钻具): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text
        model(型号): Text
            index: Text
        componentOf(属于钻具): DrillingTool
            constraint: MultiValue

Formation(地层条件): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text

QualityIndicator(取心质量指标): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text

EngineeringCase(工程案例): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text
        usesDrillingMethod(采用钻进方法): DrillingMethod
            constraint: MultiValue
        usesCoringMethod(采用取心方法): CoringMethod
            constraint: MultiValue
        usesBit(使用钻头): DrillBit
            constraint: MultiValue
        usesTool(使用钻具): DrillingTool
            constraint: MultiValue
        encounters(遇到地层): Formation
            constraint: MultiValue
        sourceUrl(来源地址): Text

DiagnosticKnowledge(诊断知识版本): EntityType
    properties:
        version(内容指纹): Text
        desc(适用范围): Text
        hasRule(包含规则): DiagnosticRule
            constraint: MultiValue
        hasCase(包含观测案例): DiagnosticCase
            constraint: MultiValue

DiagnosticRule(机制检查规则): EntityType
    properties:
        logic(条件组合方式): Text
        requiresCondition(需要观测): DiagnosticCondition
            constraint: MultiValue
        supportedBy(来源依据): DiagnosticSource
            constraint: MultiValue
        requiresMechanism(前置机制线索): DiagnosticRule
            constraint: MultiValue

DiagnosticCase(已发表事发观测): EntityType
    properties:
        domain(钻井类型): Text
        sourceUrl(来源地址): Text
        anchor(原文定位): Text
        observations(结构化观测): Text
        facts(事实摘要): Text
        limitations(资料限制): Text
        hasObservation(记录观测条件): DiagnosticCondition
            constraint: MultiValue

DiagnosticCondition(观测条件): EntityType
    properties:
        fieldName(字段标识): Text

DiagnosticSource(诊断来源): EntityType
    properties:
        sourceUrl(来源地址): Text
        desc(内容摘要): Text
        verified(核验日期): Text

Others(其他): EntityType
    properties:
        desc(描述): Text
            index: TextAndVector
        semanticType(语义类型): Text
            index: Text
